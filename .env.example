# 이 파일을 복사해 .env 를 만들고 값을 채우세요. (.env 는 Git에 올라가지 않습니다)
# 새 환경변수가 필요하면 이 파일에 "이름만" 추가하고 실제 값은 쓰지 않습니다.
FLASK_SECRET_KEY=
FLASK_DEBUG=1
FLASK_PORT=5000

OPENAI_API_KEY=
SIMULATION_OPENAI_MODEL=gpt-4.1   # (선택) AI 제형 모델링 개발요청서 읽기 모델. src/04_simulation/simulation.md 8장
OTHER_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=k-beauty-cosmetic-ingredients.p.rapidapi.com

# --- 로그인 (PM) : 계정은 업무 DB(Neon) users 에 있습니다. 아래 "업무 DB" 의 DATABASE_URL 이 필요합니다 ---
# 예전 COSMOA_DEMO_* (데모 계정 자동 생성)는 더 이상 쓰지 않습니다. 첫 계정: python -m src.common.db_admin create-first-user

# --- 홈 (A) : src/01_home/home.md 4장·5장·8장 ---
EXIM_API_KEY=            # 한국수출입은행 현재환율 API 인증키
DATA_GO_KR_KEY=          # 공공데이터포털 인증키 (관세청 수출입실적, KOTRA)
KOTRA_NEWS_URL=          # (선택) KOTRA 단신속보뉴스 요청 주소 — 기술문서 확인 후 입력
COSMETIC_HS_CODES=3304 # (선택) 화장품 HS 코드, 쉼표 구분. 예: 3303,3304,3305,3307

# --- 규제 (B) : 서버 로컬 OCR (Tesseract). 비우면 PATH/기본 설치 경로에서 찾음. src/02_regulatory/regulatory.md 13항 ---
TESSERACT_CMD=
TESSDATA_PREFIX=

# 식약처 화장품 사용제한 원료정보 API 인증키 (Decoding)
MFDS_API_KEY=

# --- AI 챗봇 (F) : src/06_chatbot/chatbot.md 13항. 본 서버(app.py)는 CHATBOT_URL / CHATBOT_SECRET 만 필요 ---
CHATBOT_URL=             # 챗봇 서버 주소 (로컬: http://127.0.0.1:5100, Render: https://<서비스명>.onrender.com)
CHATBOT_SECRET=          # 본 서버 ↔ 챗봇 서버 공유 비밀값 (양쪽에 같은 값). 비워 두면 연결 안 됨. 직접 만든 긴 임의 문자열 — CHATBOT_URL 과 다른 값, 운영·로컬 따로
CHATBOT_OPENAI_MODEL=    # (챗봇 서버) 기본 gpt-4.1
CHATBOT_PORT=            # (챗봇 서버 로컬 실행) 기본 5100

# --- 업무 DB (PM) : Neon PostgreSQL. docs/development.md 4-2. 실제 접속 주소는 .env 에만 넣습니다 ---
# Neon 브랜치: production(운영, PM 만) / dev(개발) / test(테스트). 주소는 Neon 콘솔 → 브랜치 → Connect 에서 복사
DATABASE_URL=                 # 앱용 풀링 연결 (dev 브랜치, 호스트에 -pooler). sslmode=require 포함. 팀원은 본인 앱 역할(cosmoa_app_...) 주소 (docs/db_rules.md 8장)
DATABASE_URL_DIRECT=          # 마이그레이션·관리 명령용 직접 연결 (관리 역할, DATABASE_URL 과 같은 브랜치·DB, -pooler 없음). 공통 DB 담당만
DEV_DATABASE_ENDPOINT_ID=     # 개발용으로 허용할 Neon endpoint id (ep-...). DATABASE_URL_DIRECT 호스트의 첫 부분. dev 관리 명령이 확인
TEST_DATABASE_URL=            # 테스트 전용 직접 연결 (test 브랜치). 다른 주소로 자동 대체하지 않음
TEST_DATABASE_ENDPOINT_ID=    # 테스트로 허용할 Neon endpoint id (ep-...). TEST_DATABASE_URL 호스트의 첫 부분
TEST_APP_DATABASE_URL=        # (공통 DB 담당) test 앱 로그인 역할(cosmoa_app_test) 풀링 연결. 앱 역할 검증 테스트만 사용. 비우면 그 테스트 생략
HOME_CACHE_DB_PATH=instance/cosmoa.db   # 홈 캐시 SQLite 경로 (업무 DB 와 분리)
# (선택) 공통 저장 API 크기 상한 — 비우면 기본값. 근거: docs/api_contract.md 4장
VERSION_PAYLOAD_MAX_BYTES=          # 기본 262144 (256 KiB)
VERSION_APPLIED_VALUES_MAX_BYTES=   # 기본 32768 (32 KiB)
VERSION_LINKS_MAX=                  # 기본 20
